{
  "manifest_version": 3,
  "name": "Moodle Guardian (Descargas + Anticopia)",
  "version": "0.1.0",
  "description": "Automatiza la descarga de entregas en Moodle y analiza similitud entre trabajos.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*/mod/assign/*",
    "*://*/*mod/assign/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Moodle Guardian (Descargas + Anticopia)",
    "default_popup": "popup/popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "content_scripts": [
    {
      "matches": ["*://*/mod/assign/*", "*://*/*mod/assign/*"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ]
}
